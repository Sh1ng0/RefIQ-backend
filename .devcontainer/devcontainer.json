{
  "name": "RefIQ Backend",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker": {
      "moby": false
    }
  },
  "forwardPorts": [8080, 8000, 9000, 9001],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack"
      ]
    }
  }
}
